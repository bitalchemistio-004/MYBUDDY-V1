__pycache__/
*.pyc
*.pyo
*.pyd
.Python
.pytest_cache/
.codex_tmp/
env/
venv/
.venv/

# Firmware build products
firmware/**/.pio/
firmware/**/.pio-core/
firmware/**/.cache/
firmware/**/compile_commands.json

# Audio/Log files (Optional, depends on if you save recordings)
*.wav
*.mp3
*.log

# Runtime databases
*.sqlite3
*.sqlite3-shm
*.sqlite3-wal
*.db
memory/vectors.npz
ddgs_out.txt
ddgs_test.txt

# Manual backup snapshots (not meant to be versioned)
memory_backup_*/

# OS files
.DS_Store
Thumbs.db

# Desktop shell (Tauri) build outputs
shell/node_modules/
shell/src-tauri/target/
shell/src-tauri/gen/
logs/

# Downloaded local AI model files
models/
# Benchmark audio (generated or personal voice recordings)
test_lab/stt_bench/
test_lab/tts_bench/

# Memory backups (personal data)
memory/backups/
memory/*.bak-*

# Personal memory (private to this PC)
mbuddy_memory.json
# which Ollama server MBUDDY started (U1), local to this PC
memory/ollama_started.json
memory/library/
# generated by docs/design/buddy_art/draw_chars.py (89 MB); the app's copies
# live in shell/ui/assets/buddy/chars/
docs/design/buddy_art/chars/*.png
docs/design/buddy_art/chars/*.webp
docs/design/buddy_art/chars/*.aseprite
docs/design/buddy_art/chars/*/
# agent worktrees
.claude/worktrees/

# Windows reserved-name leftovers and scratch scripts at the root
nul
/test_run.py
/test_llm_geometry.py
/web/
# Android build outputs
android/.gradle/
android/app/build/
android/build/
android/local.properties

# a release key and the file that names it: never in the repository
android/keystore.properties
android/*.jks
android/*.keystore
android/tools/regress/rg.js

# Local only: working notes, design history and audits (not part of the open-source repo)
private/
docs/audit/bench/
