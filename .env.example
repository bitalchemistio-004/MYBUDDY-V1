# MBUDDY settings. Copy to .env; every value is optional.
# Keys can also be entered in the app (Settings, Brain), which keeps them out of this file.

# The local model (Ollama, https://ollama.com): `ollama pull qwen3:4b-instruct`
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_CHAT_MODEL=qwen3:4b-instruct

# The cloud brain (Ollama Cloud): a larger model online
OLLAMA_CLOUD_API_KEY=

# Optional extra providers
GROQ_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Optional services
OPENWEATHER_API_KEY=
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_CX=

# Speech: Whisper small and Kokoro. Devices: empty = automatic (the GPU when it works), or cuda / cpu
STT_MODEL=small
STT_DEVICE=
TTS_DEVICE=

# The server
PORT=5000
DEBUG=false
