<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@drawable/widget_bg" android:padding="14dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
        <TextView android:id="@+id/w_head" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:text="TASKS" android:textColor="#9A9A94" android:textSize="10sp" android:textStyle="bold" android:letterSpacing="0.14" />
        <TextView android:id="@+id/w_count" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="" android:textColor="#FFCC33" android:textSize="12sp" android:textStyle="bold" />
    </LinearLayout>
    <LinearLayout android:id="@+id/r1" android:layout_width="match_parent" android:layout_height="40dp" android:orientation="horizontal" android:gravity="center_vertical">
        <ImageView android:id="@+id/c1" android:layout_width="40dp" android:layout_height="40dp" android:padding="7dp" android:src="@drawable/check_off" android:contentDescription="Done" />
        <TextView android:id="@+id/t1" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:maxLines="1" android:ellipsize="end" android:textColor="#F5F3EE" android:textSize="15sp" />
        <TextView android:id="@+id/m1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:textColor="#7C7C76" android:textSize="12sp" />
    </LinearLayout>
    <LinearLayout android:id="@+id/r2" android:layout_width="match_parent" android:layout_height="40dp" android:orientation="horizontal" android:gravity="center_vertical">
        <ImageView android:id="@+id/c2" android:layout_width="40dp" android:layout_height="40dp" android:padding="7dp" android:src="@drawable/check_off" android:contentDescription="Done" />
        <TextView android:id="@+id/t2" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:maxLines="1" android:ellipsize="end" android:textColor="#F5F3EE" android:textSize="15sp" />
        <TextView android:id="@+id/m2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:textColor="#7C7C76" android:textSize="12sp" />
    </LinearLayout>
    <LinearLayout android:id="@+id/r3" android:layout_width="match_parent" android:layout_height="40dp" android:orientation="horizontal" android:gravity="center_vertical">
        <ImageView android:id="@+id/c3" android:layout_width="40dp" android:layout_height="40dp" android:padding="7dp" android:src="@drawable/check_off" android:contentDescription="Done" />
        <TextView android:id="@+id/t3" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:maxLines="1" android:ellipsize="end" android:textColor="#F5F3EE" android:textSize="15sp" />
        <TextView android:id="@+id/m3" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:textColor="#7C7C76" android:textSize="12sp" />
    </LinearLayout>
    <LinearLayout android:id="@+id/r4" android:layout_width="match_parent" android:layout_height="40dp" android:orientation="horizontal" android:gravity="center_vertical">
        <ImageView android:id="@+id/c4" android:layout_width="40dp" android:layout_height="40dp" android:padding="7dp" android:src="@drawable/check_off" android:contentDescription="Done" />
        <TextView android:id="@+id/t4" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:maxLines="1" android:ellipsize="end" android:textColor="#F5F3EE" android:textSize="15sp" />
        <TextView android:id="@+id/m4" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:textColor="#7C7C76" android:textSize="12sp" />
    </LinearLayout>
    <TextView android:id="@+id/w_empty" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp"
        android:text="Nothing open. Tap to add a task." android:textColor="#9A9A94" android:textSize="14sp" />
</LinearLayout>
