<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="horizontal" android:gravity="center_vertical"
    android:background="@drawable/widget_bg" android:padding="12dp">
    <ImageView android:id="@+id/w_face" android:layout_width="48dp" android:layout_height="48dp"
        android:layout_marginEnd="12dp" android:scaleType="fitCenter" android:contentDescription="@null" />
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
        <TextView android:id="@+id/w_title" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Ask me anything" android:textColor="#F5F3EE" android:textSize="16sp" android:textStyle="bold" android:maxLines="1" />
        <TextView android:id="@+id/w_sub" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Tap to talk" android:textColor="#9A9A94" android:textSize="12sp" android:maxLines="1" android:ellipsize="end" />
    </LinearLayout>
    <ImageView android:id="@+id/w_mic" android:layout_width="40dp" android:layout_height="40dp" android:padding="9dp"
        android:background="@drawable/mic_bg" android:src="@drawable/ic_mic" android:contentDescription="Talk" />
</LinearLayout>
