<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@drawable/widget_bg" android:padding="14dp">
    <TextView android:id="@+id/w_label" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="FOCUS" android:textColor="#9A9A94" android:textSize="10sp" android:textStyle="bold" android:letterSpacing="0.14" />
    <Chronometer android:id="@+id/w_chrono" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:textColor="#FFCC33" android:textSize="34sp" android:textStyle="bold" android:fontFamily="monospace" android:visibility="gone" />
    <TextView android:id="@+id/w_ready" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="Ready" android:textColor="#F5F3EE" android:textSize="26sp" android:textStyle="bold" />
    <TextView android:id="@+id/w_sub" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="" android:textColor="#7C7C76" android:textSize="12sp" android:maxLines="1" android:ellipsize="end" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:orientation="horizontal">
        <TextView android:id="@+id/w_b1" android:layout_width="0dp" android:layout_weight="1" android:layout_height="38dp"
            android:layout_marginEnd="8dp" android:gravity="center" android:background="@drawable/btn_outline"
            android:text="Start 25" android:textColor="#FFCC33" android:textSize="14sp" android:textStyle="bold" />
        <TextView android:id="@+id/w_b2" android:layout_width="0dp" android:layout_weight="1" android:layout_height="38dp"
            android:gravity="center" android:background="@drawable/btn_outline"
            android:text="Break 5" android:textColor="#F5F3EE" android:textSize="14sp" android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
